rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public media assets (CDN-fronted WebP/AVIF)
    match /ne-media/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Managed by backend Admin SDK / CI
    }

    // Private per-user Document Vault (Permit PDFs, ID copies, tickets)
    match /ne-docs/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('image/.*')
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Versioned Offline Packs per state
    match /ne-offline-packs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Generated by backend worker
    }
  }
}
