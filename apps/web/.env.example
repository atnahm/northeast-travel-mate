# Next.js Frontend Environment Template (copy to apps/web/.env.local)
API_BASE_URL=http://127.0.0.1:8000

# Firebase Web SDK (Project Settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ne-travel-mate.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ne-travel-mate
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ne-travel-mate.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Google Maps JavaScript API Browser Key
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
