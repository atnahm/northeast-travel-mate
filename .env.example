# ==============================================================================
# NE Mate (North-East India Travel Mate) — Environment Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit real secrets or service account JSON files.
# ==============================================================================

# --- App Environment ---
APP_ENV=local
APP_VERSION=1.0.0
API_BASE_URL=http://127.0.0.1:8000
AGENT_BASE_URL=http://127.0.0.1:8001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Firebase Backend (Firestore + Auth + Storage) ---
# FIREBASE_MODE:
#   auto      -> Uses Firestore/Emulator if configured, otherwise falls back to local JSON NoSQL store (data/.local_db/)
#   firestore -> Requires real Cloud Firestore credentials (fails fast if missing)
#   emulator  -> Connects to local Firebase Emulator Suite (FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST)
#   local     -> Always uses local JSON NoSQL store (data/.local_db/)
FIREBASE_MODE=auto
FIREBASE_PROJECT_ID=ne-mate-dev
FIREBASE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=
# Provide ONE of the following credential options for live Cloud Firestore:
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Firebase Local Emulator Hosts:
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Local dev auth bypass (only honored when FIREBASE_MODE resolves to local fallback; NEVER enable in production)
DEV_AUTH_BYPASS=true

# --- Firebase Frontend (Web SDK) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# --- Google Maps Platform ---
# Browser key: restrict by HTTP referrer & Maps JavaScript API in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server key: restrict by server IP & Places API (New), Routes API, Geocoding API
GOOGLE_MAPS_SERVER_KEY=

# --- AI / LLM & Embeddings (Server-side only) ---
# LLM_PROVIDER: gemini | openai
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
LLM_DAILY_TOKEN_BUDGET=100000

# --- Redis Cache & Queues ---
REDIS_URL=redis://localhost:6379/0

# --- External Pluggable Providers ---
# Railway data (first provider only; unofficial, quota and terms can change).
# Keep RAPIDAPI_LIVE_ENABLED=false on low-quota free plans to serve the saved local timetable (0 live calls),
# and use data/trains/sync_rapidapi_corridors.py --max-requests N for one-time budget-capped timetable downloads.
RAPIDAPI_RAILWAY_KEY=
RAPIDAPI_RAILWAY_HOST=irctc1.p.rapidapi.com
RAPIDAPI_LIVE_ENABLED=false
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nemate.example.in

# --- Observability ---
SENTRY_DSN=
